{
  "name": "metria-ai-quality-workbench",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "dev": "npm run services && ng serve --host 127.0.0.1 --port 4200",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "services": "docker compose up -d app-postgres && docker compose up -d --force-recreate keycloak && npm run services:wait && npm run services:seed",
    "db:shell": "docker compose exec app-postgres psql -U metria -d metria_map",
    "db:status": "docker compose exec app-postgres pg_isready -U metria -d metria_map",
    "services:seed": "node ./scripts/seed-keycloak.mjs",
    "services:wait": "node ./scripts/wait-for-keycloak.mjs",
    "services:down": "docker compose down",
    "keycloak:up": "npm run services",
    "keycloak:down": "npm run services:down",
    "storybook": "ng run metria-ai-quality-workbench:storybook",
    "build-storybook": "ng run metria-ai-quality-workbench:build-storybook",
    "e2e": "cypress run",
    "e2e:open": "cypress open",
    "quality": "npm run format:check && npm run lint && npm test && npm run build",
    "release": "semantic-release",
    "prepare": "husky"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "engines": {
    "node": ">=20.19 <25",
    "npm": ">=10"
  },
  "private": true,
  "dependencies": {
    "@amcharts/amcharts5": "^5.18.0",
    "@angular/animations": "^20.3.25",
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/material": "^20.2.14",
    "@angular/platform-browser": "^20.3.0",
    "@angular/platform-browser-dynamic": "^20.3.25",
    "@angular/router": "^20.3.0",
    "@apollo/client": "^4.2.3",
    "@esri/calcite-components": "^5.1.0",
    "@fastify/cors": "^11.2.0",
    "@fontsource/inter": "^5.2.8",
    "@jsverse/transloco": "^8.3.0",
    "@microsoft/signalr": "^10.0.0",
    "@stomp/stompjs": "^7.3.0",
    "@swimlane/ngx-charts": "^20.5.0",
    "@turf/turf": "^7.3.5",
    "ag-grid-angular": "^35.3.1",
    "ag-grid-community": "^35.3.1",
    "angular-oauth2-oidc": "^20.0.3",
    "chart.js": "^4.5.1",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "fastify": "^5.8.5",
    "graphql": "^16.14.2",
    "jspdf": "^4.2.1",
    "jsts": "^2.12.1",
    "keycloak-js": "^26.2.4",
    "luxon": "^3.7.2",
    "material-symbols": "^0.44.12",
    "moment": "^2.30.1",
    "ol": "^10.9.0",
    "proj4": "^2.20.9",
    "rxjs": "~7.8.0",
    "sockjs-client": "^1.6.1",
    "tslib": "^2.3.0",
    "xlsx": "^0.18.5",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.6.0",
    "@analogjs/vitest-angular": "^2.6.0",
    "@angular-devkit/build-angular": "^20.3.27",
    "@angular/build": "^20.3.27",
    "@angular/cli": "^20.3.27",
    "@angular/compiler-cli": "^20.3.0",
    "@compodoc/compodoc": "^1.2.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@storybook/angular": "^10.4.3",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/angular": "^18.1.1",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^25.9.3",
    "angular-eslint": "^20.7.0",
    "autoprefixer": "^10.5.0",
    "cypress": "^15.17.0",
    "eslint": "^9.39.4",
    "husky": "^9.1.7",
    "jasmine-core": "~5.9.0",
    "jsdom": "^29.1.1",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "nx": "^22.7.5",
    "postcss": "^8.5.15",
    "prettier": "^3.8.4",
    "semantic-release": "^25.0.5",
    "storybook": "^10.4.3",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.4",
    "typescript": "~5.9.2",
    "vitest": "^3.2.6"
  }
}
