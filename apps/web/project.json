{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "root": "apps/web",
  "sourceRoot": "apps/web/src",
  "projectType": "application",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ng serve web --host 127.0.0.1 --port 4200"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/web"],
      "options": {
        "command": "ng build web"
      }
    },
    "watch": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ng build web --watch --configuration development"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/apps/web"],
      "options": {
        "command": "vitest run --config apps/web/vitest.config.ts"
      }
    },
    "test-watch": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest --config apps/web/vitest.config.ts"
      }
    },
    "test-ui": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest --ui --config apps/web/vitest.config.ts"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint \"apps/web/**/*.{ts,html}\""
      }
    },
    "storybook": {
      "executor": "nx:run-commands",
      "options": {
        "command": "storybook dev -p 6006 -c apps/web/.storybook"
      }
    },
    "build-storybook": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/storybook/web"],
      "options": {
        "command": "storybook build -c apps/web/.storybook -o dist/storybook/web"
      }
    }
  },
  "tags": ["scope:web", "type:app"]
}
